# 复制为 /home/admin/workboard/config/workboard.env 后修改
# 权限必须 600：chmod 600 /home/admin/workboard/config/workboard.env

WB_HOST=127.0.0.1
WB_PORT=8100

# ⚠️ 必须修改：换成随机字符串（可用 openssl rand -hex 32 生成）
WB_JWT_SECRET=CHANGE_ME_USE_RANDOM_32BYTES

# ⚠️ 必须修改：管理员登录密码（页面登录 + 同步桥接器都用这个）
WB_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

WB_JWT_TTL_HOURS=168
WB_RATE_LIMIT=300

# 自有 AI（可选，OpenAI 兼容端点；留空则 AI 问答返回 503）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Agent 上下文预算（字符），可按模型窗口自行调整；改后重启服务
AI_CONTEXT_MAX=300000
